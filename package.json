{
  "name": "snowflake-ai-credit-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "npm run start",
    "build": "vite build",
    "build:streamlit": "vite build --mode streamlit && node scripts/verify-streamlit-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "streamlit": "npm run build:streamlit && python3 -m streamlit run streamlit_app.py",
    "check": "npm run build && npm run build:streamlit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

